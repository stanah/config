# theme = TokyoNight
theme = Hardcore


# Font
font-family = PlemolJP Console NF
font-size = 14
font-thicken = true

# Window
background-opacity = 0.8
background-blur = true

window-save-state = always
window-inherit-working-directory = true
adjust-cell-height = 2

# クリップボード
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true

# Keybindings
keybind = ctrl+h=goto_split:left
keybind = ctrl+l=goto_split:right

# Cmd+Space → C-Space (tmux prefix)
keybind = cmd+space=text:\x00

# Ghostty native operations (Cmd+S leader)
keybind = cmd+s>r=reload_config
keybind = cmd+s>x=close_surface
keybind = cmd+s>n=new_window
keybind = cmd+s>c=new_tab
keybind = cmd+s>shift+l=next_tab
keybind = cmd+s>shift+h=previous_tab
keybind = cmd+s>comma=move_tab:-1
keybind = cmd+s>period=move_tab:1
keybind = cmd+s>1=goto_tab:1
keybind = cmd+s>2=goto_tab:2
keybind = cmd+s>3=goto_tab:3
keybind = cmd+s>4=goto_tab:4
keybind = cmd+s>5=goto_tab:5
keybind = cmd+s>6=goto_tab:6
keybind = cmd+s>7=goto_tab:7
keybind = cmd+s>8=goto_tab:8
keybind = cmd+s>9=goto_tab:9
keybind = cmd+s>\=new_split:right
keybind = cmd+s>-=new_split:down
keybind = cmd+s>j=goto_split:bottom
keybind = cmd+s>k=goto_split:top
keybind = cmd+s>h=goto_split:left
keybind = cmd+s>l=goto_split:right
keybind = cmd+s>z=toggle_split_zoom
keybind = cmd+s>e=equalize_splits

# === Cmd → tmux: Pane navigation (CSI modifier 9 = Super) ===
keybind = cmd+left=text:\x1b[1;9D
keybind = cmd+right=text:\x1b[1;9C
keybind = cmd+up=text:\x1b[1;9A
keybind = cmd+down=text:\x1b[1;9B

# === Cmd+Shift → tmux: Tab navigation (CSI modifier 10 = Super+Shift) ===
keybind = cmd+shift+left=text:\x1b[1;10D
keybind = cmd+shift+right=text:\x1b[1;10C

# === Cmd → tmux: Operations (CSI ~ encoding for user-keys compat) ===
keybind = cmd+n=text:\x1b[110;9~
keybind = cmd+shift+n=text:\x1b[110;10~
keybind = cmd+x=text:\x1b[120;9~
keybind = cmd+shift+x=text:\x1b[120;10~
keybind = cmd+f=text:\x1b[102;9~
keybind = cmd+g=text:\x1b[103;9~


shell-integration = detect

# Behavior
quit-after-last-window-closed = true


# mac
# macos-titlebar-style = tabs
macos-option-as-alt = true

# Copy/paste with Cmd key (Ghostty handles these)
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
