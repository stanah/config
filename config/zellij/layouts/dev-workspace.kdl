// Development Workspace Layout
// 4 columns x 2 rows with synchronized pane switching
//
// Upper row: companion tools (lazygit, shell, yazi, etc.)
// Lower row: main work panes (Claude Code, editors, etc.)
//
// When you focus a lower pane, the corresponding upper pane
// becomes visible (if using stacked panes).

layout {
    // Default template for new tabs
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="workspace" focus=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }

        // Main content area
        pane split_direction="vertical" {
            // Column 1
            pane split_direction="horizontal" {
                // Upper: stacked companion tools
                pane stacked=true size="40%" {
                    pane name="lazygit-1" command="lazygit"
                    pane name="shell-1"
                    pane name="yazi-1" command="yazi"
                }
                // Lower: main work area
                pane name="main-1" focus=true size="60%"
            }

            // Column 2
            pane split_direction="horizontal" {
                pane stacked=true size="40%" {
                    pane name="lazygit-2" command="lazygit"
                    pane name="shell-2"
                    pane name="yazi-2" command="yazi"
                }
                pane name="main-2" size="60%"
            }

            // Column 3
            pane split_direction="horizontal" {
                pane stacked=true size="40%" {
                    pane name="lazygit-3" command="lazygit"
                    pane name="shell-3"
                    pane name="yazi-3" command="yazi"
                }
                pane name="main-3" size="60%"
            }

            // Column 4
            pane split_direction="horizontal" {
                pane stacked=true size="40%" {
                    pane name="lazygit-4" command="lazygit"
                    pane name="shell-4"
                    pane name="yazi-4" command="yazi"
                }
                pane name="main-4" size="60%"
            }
        }

        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
